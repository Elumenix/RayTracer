                        }
                    ]
                }
            },
            "required": ["add", "material", "transform"],
            "defaultSnippets": [
                {
                    "label": "Sphere",
                    "sortText": "2_Sphere",
                    "description": "A sphere that will be added to the scene.",
                    "body": {
                        "add": "sphere",
                        "material": {},
                        "transform": {}
                    }
                }
            ]
        },
        "Cube": {
            "type": "object",
            "doNotSuggest": true,
            "additionalProperties": false,
            "properties": {
                "add": {
                    "description": "A cube that will be added to the scene.",
                    "const": "cube",
                    "doNotSuggest": true
                },
                "material": {
                    "description": "The material of the cube.",
                    "doNotSuggest": true,
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Material"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "transform": {
                    "description": "The transform of the cube.",
                    "doNotSuggest": true,
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Transform"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": ["add", "material", "transform"],
            "defaultSnippets": [
                {
                    "label": "Cube",
                    "sortText": "2_Cube",
                    "description": "A cube that will be added to the scene.",
                    "body": {
                        "add": "cube",
                        "material": {},
                        "transform": {}
