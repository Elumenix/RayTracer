                    "doNotSuggest": true
                },
                "material": {
                    "description": "The material of the sphere.",
                    "doNotSuggest": true,
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Material"
                        },
                        {
                            "type": "string"
