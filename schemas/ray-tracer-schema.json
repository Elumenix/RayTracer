{ 
    "type": "array",
    "items": {
        "type": "object",
        "oneOf": [
            { "$ref": "#/definitions/Camera" },
            { "$ref": "#/definitions/Light" },
            { "$ref": "#/definitions/Plane" },
            { "$ref": "#/definitions/Sphere" },
            { "$ref": "#/definitions/Cube" },
            { "$ref": "#/definitions/Define" }
        ]
    },

    "definitions": {
        "Camera": {
            "type": "object",
            "doNotSuggest": true,
            "additionalProperties": false,
            "properties": {
                "add": {
                    "description": "The camera settings for the scene. Controls the direction, fov, and image size generated.\nOnly one camera can be added to a scene.",
                    "const": "camera",
                    "doNotSuggest": true
                },
                "width": {
                    "description": "The width (in pixels) of the generated image.",
                    "type": "integer",
                    "minimum": 1,
                    "doNotSuggest": true
                },
                "height": {
                    "description": "The height (in pixels) of the generated image.",
                    "type": "integer",
                    "minimum": 1,
                    "doNotSuggest": true
                },
                "field-of-view": {
                    "description": "The field of view of the camera.",
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 3.14159,
                    "doNotSuggest": true
                },
                "from": {
                    "description": "The position of the camera in 3D space.",
                    "$ref": "#/definitions/Vec3"
                },
                "to": {
                    "description": "The point the camera is looking at in 3D space.",
                    "$ref": "#/definitions/Vec3"
                },
                "up": {
                    "description": "The up vector of the camera in 3D space.",
                    "$ref": "#/definitions/Vec3"
                }
            },
            "required": ["add", "width", "height", "field-of-view"],
            "defaultSnippets": [
                {
                    "label": "Camera",
                    "sortText": "1_Camera",
                    "description": "A minimal camera implementation.",
                    "body": {
                        "add": "camera",
                        "width": 128,
                        "height": 128,
                        "field-of-view": 1.0472
                    }
                },
                {
                    "label": "Camera (Expanded)",
                    "sortText": "1_CameraFull",
                    "description": "A camera with all fields defined.",
                    "body": {
                        "add": "camera",
                        "width": 128,
                        "height": 128,
                        "field-of-view": 1.0472,
                        "from": "[0, 0, 0]",
                        "to": "[0, 0, -1]",
                        "up": "[0, 1, 0]"
                    }
                }
            ]
        },
        "Light": {
            "type": "object",
            "doNotSuggest": true,
            "additionalProperties": false,
            "properties": {
                "add": {
                    "description": "A point light that will light up things around it.",
                    "const": "light",
                    "doNotSuggest": true
                },
                "at": {
                    "description": "The position of the light in 3D space.",
                    "$ref": "#/definitions/Vec3"
                },
                "intensity": {
                    "description": "The color of the light.",
                    "$ref": "#/definitions/Color"
                }
            },
            "required": ["add", "at", "intensity"],
            "defaultSnippets": [
                {
                    "label": "Light",
                    "sortText": "1_Light",
                    "description": "A point light that will light up things around it.",
                    "body": {
                        "add": "light",
                        "at": "[0, 0, 0]",
                        "intensity": "[1, 1, 1]"
                    }
                }
            ]
        },
        "Plane": {
            "type": "object",
            "doNotSuggest": true,
            "additionalProperties": false,
            "properties": {
                "add": {
                    "description": "A plane that will be added to the scene.",
                    "const": "plane",
                    "doNotSuggest": true
                },
                "material": {
                    "description": "The material of the plane.",
                    "doNotSuggest": true,
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Material"
                        },
                        {
                            "type": "string"
                        }
                    ]
                },
                "transform": {
                    "description": "The transform of the plane.",
                    "doNotSuggest": true,
                    "oneOf": [
                        {
                            "$ref": "#/definitions/Transform"
                        },
                        {
                            "type": "string"
                        }
                    ]
                }
            },
            "required": ["add", "material", "transform"],
            "defaultSnippets": [
                {
                    "label": "Plane",
                    "sortText": "2_Plane",
                    "description": "A plane that will be added to the scene.",
                    "body": {
                        "add": "plane",
                        "material": {},
                        "transform": {}
                    }
                }
            ]
        },
        "Sphere": {
            "type": "object",
            "doNotSuggest": true,
            "additionalProperties": false,
            "properties": {
                "add": {
                    "description": "A sphere that will be added to the scene.",
